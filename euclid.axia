-- THE FOUNDATIONS OF GEOMETRY

-- 1. Primitives
Pt : Type
Line : Type
Circle : Type

-- 2. Relationships
-- "Point p is on Line l"
On : Pt -> Line -> Prop
-- "Distance between p and q is equal to distance between a and b"
DistEq : Pt -> Pt -> Pt -> Pt -> Prop
-- "Points are collinear (lie on the same line)"
Collinear : Pt -> Pt -> Pt -> Prop
-- "Lines are Parallel"
Parallel : Line -> Line -> Prop
-- "Lines Intersect"
Intersect : Line -> Line -> Prop

-- 3. Basic Definitions (Using NOT and OR)

-- Definition: If lines intersect, they are NOT parallel
Def_NotPar : forall l m : Line, Intersect(l, m) -> not Parallel(l, m)

-- Definition: If lines are Parallel, they do NOT intersect
Def_Par : forall l m : Line, Parallel(l, m) -> not Intersect(l, m)

-- Axiom: Two lines are either Parallel OR they Intersect
Ax_Dichotomy : forall l m : Line, Parallel(l, m) or Intersect(l, m)

-- 4. Euclid's Postulates (Simplified for First Order Logic)

-- Postulate 1: Any two points determine a line
-- (Note: We simplify "Exists a line" to "Line(a, b)" function for now)
LineFrom : Pt -> Pt -> Line
Ax_Postulate1 : forall a b : Pt, On(a, LineFrom(a, b)) and On(b, LineFrom(a, b))

-- Postulate 2 is about extending lines (skipped for now)

-- Postulate 3: Circles
CircFrom : Pt -> Pt -> Circle
