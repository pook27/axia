-- PEANO ARITHMETIC KERNEL

-- Import base equality
import logic

-- Types and Constants
Nat : Type
Z : Nat

-- Successor and Addition functions
S : Nat -> Nat
Add : Nat -> Nat -> Nat

-- 1. Definition of Addition
-- Base Case: n + 0 = n
Add_Zero : forall n : Nat, Add(n, Z) = n

-- Recursive Case: n + S(m) = S(n + m)
Add_Succ : forall n m : Nat, Add(n, S(m)) = S(Add(n, m))

-- 2. Congruence (Compatibility)
-- If a = b, then S(a) = S(b)
Cong_Succ : forall a b : Nat, a = b -> S(a) = S(b)
