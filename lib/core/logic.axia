-- ==========================================
-- CORE LOGIC & EQUALITY
-- ==========================================

Object : Type

-- 1. Equality Axioms
axiom Eq_Refl : forall x : Object, x = x
axiom Eq_Symm : forall x y : Object, x = y -> y = x
axiom Eq_Trans : forall x y z : Object, x = y and y = z -> x = z
